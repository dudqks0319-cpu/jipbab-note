# Recipe source fallback
MFDS_API_KEY=
# FOODSAFETY_API_KEY=

# Optional server-only operational alert delivery. Keep disabled until the
# monitoring vendor, retention, channel owner, and synthetic alert are approved.
OPERATIONAL_ALERTS_ENABLED=false
OPERATIONAL_ALERT_WEBHOOK_URL=
OPERATIONAL_ALERT_HMAC_SECRET=

# Android Play Store upload signing. Keep the keystore and passwords outside git.
ANDROID_UPLOAD_KEYSTORE_PATH=
ANDROID_UPLOAD_KEYSTORE_PASSWORD=
ANDROID_UPLOAD_KEY_ALIAS=
ANDROID_UPLOAD_KEY_PASSWORD=

# Optional store-console API verification. Keep keys outside git.
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_PRIVATE_KEY_PATH=
APP_STORE_CONNECT_BUNDLE_ID=com.jipbab.note
APP_STORE_CONNECT_BUILD_VERSION=2026052001
GOOGLE_APPLICATION_CREDENTIALS=
