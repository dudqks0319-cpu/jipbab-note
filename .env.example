# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional API base override
NEXT_PUBLIC_API_BASE_URL=
CAPACITOR_SERVER_URL=
NEXT_PUBLIC_COMMUNITY_ENABLED=false

# Optional OAuth provider flags
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=google,apple,kakao
NEXT_PUBLIC_SUPABASE_OAUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_SUPABASE_OAUTH_KAKAO_ENABLED=true
NEXT_PUBLIC_SUPABASE_OAUTH_APPLE_ENABLED=true

# Optional Coupang Partners deep links
NEXT_PUBLIC_COUPANG_PARTNERS_POTATO_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_VEGETABLE_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_EGG_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_DAIRY_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_FROZEN_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_SEASONING_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_ITEM_LINKS_JSON={"계란":"https://link.coupang.com/a/your-egg-link","두부":"https://link.coupang.com/a/your-tofu-link"}

# Recipe source fallback
MFDS_API_KEY=
# FOODSAFETY_API_KEY=

# Android Play Store upload signing. Keep the keystore and passwords outside git.
ANDROID_UPLOAD_KEYSTORE_PATH=
ANDROID_UPLOAD_KEYSTORE_PASSWORD=
ANDROID_UPLOAD_KEY_ALIAS=
ANDROID_UPLOAD_KEY_PASSWORD=
