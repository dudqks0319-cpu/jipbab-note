# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=google,kakao,apple
NEXT_PUBLIC_SUPABASE_OAUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_SUPABASE_OAUTH_KAKAO_ENABLED=true
NEXT_PUBLIC_SUPABASE_OAUTH_APPLE_ENABLED=true

# Kakao JavaScript SDK for KakaoTalk sharing.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Optional server-side recipe/ingredient APIs.
MFDS_API_KEY=
FOODSAFETY_API_KEY=

# Optional API origin override for native/webview builds.
NEXT_PUBLIC_API_BASE_URL=
