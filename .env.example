# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_ANONYMOUS_AUTH_ENABLED=false
API_RATE_LIMIT_HMAC_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional API base override
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=
CAPACITOR_SERVER_URL=
NEXT_PUBLIC_COMMUNITY_ENABLED=false

# Optional OAuth provider flags
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=google,apple,kakao
NEXT_PUBLIC_SUPABASE_OAUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_SUPABASE_OAUTH_KAKAO_ENABLED=false
NEXT_PUBLIC_SUPABASE_OAUTH_APPLE_ENABLED=false
KAKAO_ACCOUNT_EMAIL_PERMISSION_CONFIRMED=false

# Optional Coupang Partners deep links
NEXT_PUBLIC_COUPANG_PARTNERS_POTATO_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_VEGETABLE_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_EGG_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_DAIRY_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_FROZEN_URL=
NEXT_PUBLIC_COUPANG_PARTNERS_SEASONING_URL=
